<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>sqa.closure</groupId>
    <artifactId>closure-chatgpt-tests</artifactId>
    <version>1.0-SNAPSHOT</version>
    <name>Closure ChatGPT TestCode</name>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>8</maven.compiler.release>
    </properties>

    <dependencies>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>3.8.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <id>add-closure-test-sources</id>
                        <phase>generate-test-sources</phase>
                        <goals><goal>add-test-source</goal></goals>
                        <configuration>
                            <sources>
                                <source>${project.basedir}/TestCode/Closure-1</source>
                                <source>${project.basedir}/TestCode/Closure-2</source>
                                <source>${project.basedir}/TestCode/Closure-3</source>
                                <source>${project.basedir}/TestCode/Closure-4</source>
                                <source>${project.basedir}/TestCode/Closure-5</source>
                                <source>${project.basedir}/TestCode/Closure-6</source>
                                <source>${project.basedir}/TestCode/Closure-7</source>
                                <source>${project.basedir}/TestCode/Closure-8</source>
                                <source>${project.basedir}/TestCode/Closure-9</source>
                                <source>${project.basedir}/TestCode/Closure-10</source>
                                <source>${project.basedir}/TestCode/Closure-11</source>
                                <source>${project.basedir}/TestCode/Closure-12</source>
                                <source>${project.basedir}/TestCode/Closure-13</source>
                                <source>${project.basedir}/TestCode/Closure-14</source>
                                <source>${project.basedir}/TestCode/Closure-15</source>
                                <source>${project.basedir}/TestCode/Closure-16</source>
                                <source>${project.basedir}/TestCode/Closure-17</source>
                                <source>${project.basedir}/TestCode/Closure-18</source>
                                <source>${project.basedir}/TestCode/Closure-19</source>
                                <source>${project.basedir}/TestCode/Closure-20</source>
                                <source>${project.basedir}/TestCode/Closure-21</source>
                                <source>${project.basedir}/TestCode/Closure-22</source>
                                <source>${project.basedir}/TestCode/Closure-23</source>
                                <source>${project.basedir}/TestCode/Closure-24</source>
                                <source>${project.basedir}/TestCode/Closure-25</source>
                                <source>${project.basedir}/TestCode/Closure-26</source>
                            </sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>
        </plugins>
    </build>
</project>
