# The interactive setup writes .env; API keys are never included in this ZIP.
API_BASE_URL="https://gen.ai.kku.ac.th/api/v1"
KKU_API_KEY="YOUR_KKU_API_KEY"
# Exact model IDs from your account. setup lists models; do not guess names.
MODEL_1=""
MODEL_2=""
PROJECT="Closure"
MAX_OUTPUT_TOKENS="6000"
MAX_REPAIRS="2"
STABILITY_RUNS="2"
COMMAND_TIMEOUT="900"
API_TIMEOUT="180"
MAX_SOURCE_CHARS="65000"
# Empty paths are auto-detected; no Windows-path editing is needed.
DEFECTS4J_BIN=""
WORK_BASE=""
RESULT_BASE=""
EVOSUITE_SOURCE=""
EVOSUITE_JAR=""
SEARCH_BUDGET="30"
POPULATION="30"
RANDOM_SEED="20260930"
CRITERIA="LINE:BRANCH:EXCEPTION:WEAKMUTATION:OUTPUT:METHOD:CBRANCH"
