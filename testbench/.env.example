# Copy this file to .env and add your OpenRouter key locally.
OPENROUTER_API_KEY=
TESTBENCH_PORT=8081
TESTBENCH_BIND_ADDRESS=127.0.0.1
# Where results and Defects4J working checkouts are written (default ./output). Put it on an SSD/NVMe if the project is on a HDD.
#TESTBENCH_OUTPUT_DIR=/mnt/fast-disk/testbench-output
# How many Defects4J evaluations/algorithm runs may run at the same time (1 = one at a time). The search budget is wall-clock time, so
# keep this below the number of free CPU cores. Rule of thumb: cores / 3 with ~1.5 GB free RAM per job (8-core/16 GB laptop: 2,
# 32-core server: 6-8). Too high and SA/BPSO get fewer search iterations in their time budget - fewer detections, no error.
BENCH_PARALLELISM=1
# Shared server: at most this many CPU cores for TestBench (0 = no cap). Example for a 32-core server: TESTBENCH_CPUS=24
TESTBENCH_CPUS=0
# After each evaluation the buggy/fixed checkouts (hundreds of MB per bug) are deleted and only the evidence is kept
# (suite, logs, failing tests, coverage, patch). Set true to keep the checkouts too.
BENCH_KEEP_WORKSPACES=false
# Exchange rate used only to show an approximate baht amount on the /usage page.
BENCH_USD_TO_THB=33

# Round-2 search seeding: literals from the project's own tests (trigger tests removed) and factory-made objects. Off for round 1.
BENCH_TEST_SEEDING=false
