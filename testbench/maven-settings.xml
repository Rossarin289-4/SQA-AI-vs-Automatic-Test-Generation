<?xml version="1.0" encoding="UTF-8"?>
<!-- Mounted into the container as /root/.m2/settings.xml (docker-compose.yml). Maven Central rate-limits busy addresses
     (HTTP 429) and the app then cannot start; Google's read-only mirror of Central serves the same artifacts. -->
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0 https://maven.apache.org/xsd/settings-1.2.0.xsd">
  <mirrors>
    <mirror>
      <id>google-maven-central</id>
      <name>Google mirror of Maven Central</name>
      <url>https://maven-central.storage-download.googleapis.com/maven2/</url>
      <mirrorOf>central</mirrorOf>
    </mirror>
  </mirrors>
</settings>
