#!/bin/zsh

set -u

ROOT="$(cd "$(dirname "$0")/../.." && pwd)"

PROJECT="${1:-}"
BUG="${2:-}"
METHOD="${3:-}"
ARTIFACT_DIR="${4:-}"

if [[ -z "$PROJECT" || -z "$BUG" || -z "$METHOD" || -z "$ARTIFACT_DIR" ]]; then
    echo "Usage:"
    echo "  $0 <project> <bug> <method> <artifact_dir>"
    exit 2
fi

case "$METHOD" in
    SA|BPSO)
        ;;
    *)
        echo "ERROR: unsupported method: $METHOD"
        exit 2
        ;;
esac

mkdir -p "$ARTIFACT_DIR"

if [[ "$PROJECT" != "Lang" ]]; then
    echo "ERROR: generic generator currently supports Lang only."
    printf '%s\n' "PENDING_GENERATOR" > "$ARTIFACT_DIR/status"
    exit 3
fi

METADATA="$ROOT/automation/datasets/Lang/bugs.csv"

if [[ ! -f "$METADATA" ]]; then
    echo "ERROR: metadata not found:"
    echo "$METADATA"
    exit 3
fi

echo "============================================================"
echo "GENERIC ALGORITHM TEST GENERATION"
echo "============================================================"
echo "Project     : $PROJECT"
echo "Bug         : $BUG"
echo "Method      : $METHOD"
echo "Artifact    : $ARTIFACT_DIR"
echo "============================================================"

###############################################################################
# Read metadata safely with Python.
###############################################################################

META_JSON="$(
python3 - "$METADATA" "$BUG" <<'PY'
import csv
import json
import sys

metadata = sys.argv[1]
bug = str(sys.argv[2])

with open(metadata, newline="", encoding="utf-8") as f:
    rows = list(csv.DictReader(f))

matches = [r for r in rows if str(r["bug_id"]) == bug]

if not matches:
    print(json.dumps({"error": "bug_not_found"}))
    raise SystemExit(0)

row = matches[0]

trigger = row.get("trigger_test", "")
modified = row.get("modified_source", "")

tests = []

for line in trigger.splitlines():
    line = line.strip()

    if line.count("::") != 1:
        continue

    cls, method = line.split("::", 1)
    cls = cls.strip()
    method = method.strip()

    if cls and method:
        item = (cls, method)
        if item not in tests:
            tests.append(item)

target_class = modified
if target_class.endswith(".java"):
    target_class = target_class[:-5]

target_class = target_class.replace("/", ".")

result = {
    "bug": bug,
    "target_class": target_class,
    "trigger_tests": [
        {
            "class": c,
            "method": m
        }
        for c, m in tests
    ]
}

print(json.dumps(result))
PY
)"

if [[ "$META_JSON" == *'"error"'* ]]; then
    echo "ERROR: could not read Lang metadata."
    echo "$META_JSON"
    printf '%s\n' "PENDING_GENERATOR" > "$ARTIFACT_DIR/status"
    exit 3
fi

TARGET_CLASS="$(
python3 - "$META_JSON" <<'PY'
import json
import sys
print(json.loads(sys.argv[1])["target_class"])
PY
)"

TARGET_METHOD="$(
python3 - "$META_JSON" <<'PY'
import json
import sys

data = json.loads(sys.argv[1])
tests = data.get("trigger_tests", [])

if tests:
    print(tests[0]["method"])
else:
    print("")
PY
)"

PACKAGE_NAME="${TARGET_CLASS%.*}"

if [[ -z "$TARGET_CLASS" || -z "$TARGET_METHOD" ]]; then
    echo "ERROR: target class/method could not be determined."
    printf '%s\n' "PENDING_GENERATOR" > "$ARTIFACT_DIR/status"
    exit 3
fi

CLASS_SUFFIX="SA"

if [[ "$METHOD" == "BPSO" ]]; then
    CLASS_SUFFIX="BPSO"
fi

TEST_CLASS="Lang${BUG}GeneratedTest${CLASS_SUFFIX}"

echo ""
echo "Target class : $TARGET_CLASS"
echo "Target method: $TARGET_METHOD"
echo "Package      : $PACKAGE_NAME"
echo "Test class   : $TEST_CLASS"


###############################################################################
# Compile generic engine + candidate infrastructure.
###############################################################################

TMP_ROOT="$(mktemp -d "/tmp/sqa_generic_${PROJECT}_${BUG}_${METHOD}_XXXXXX")"

ENGINE_CLASSES="$TMP_ROOT/classes"
DRIVER="$TMP_ROOT/GenericAlgorithmDriver.java"

mkdir -p "$ENGINE_CLASSES"

COMMON="$ROOT/automation/scripts/generators/common"
SA="$ROOT/automation/scripts/generators/sa"
BPSO="$ROOT/automation/scripts/generators/bpso"

if [[ ! -f "$COMMON/Candidate.java" ||
      ! -f "$COMMON/CandidateProvider.java" ||
      ! -f "$SA/SimulatedAnnealingEngine.java" ||
      ! -f "$BPSO/BinaryParticleSwarmEngine.java" ]]; then

    echo "ERROR: generic engine source is incomplete."
    printf '%s\n' "PENDING_GENERATOR" > "$ARTIFACT_DIR/status"
    exit 3
fi

javac \
    -d "$ENGINE_CLASSES" \
    "$COMMON/Candidate.java" \
    "$COMMON/CandidateProvider.java" \
    "$SA/SimulatedAnnealingEngine.java" \
    "$BPSO/BinaryParticleSwarmEngine.java"

if [[ $? -ne 0 ]]; then
    echo "ERROR: generic engine compilation failed."
    printf '%s\n' "PENDING_GENERATOR" > "$ARTIFACT_DIR/status"
    exit 3
fi


###############################################################################
# Generate Java driver.
#
# Candidate generation is independent of the original trigger inputs.
# Candidates are runtime invocation strategies using type-driven values.
###############################################################################

cat > "$DRIVER" <<'JAVA'
import generators.common.Candidate;
import generators.common.CandidateProvider;
import generators.sa.SimulatedAnnealingEngine;
import generators.bpso.BinaryParticleSwarmEngine;

import java.io.File;
import java.io.FileWriter;
import java.io.IOException;
import java.util.ArrayList;
import java.util.Arrays;
import java.util.LinkedHashSet;
import java.util.List;
import java.util.Set;

public class GenericAlgorithmDriver {

    private static final long SEED = 20260923L;

    private static String javaString(String s) {
        return s
                .replace("\\", "\\\\")
                .replace("\"", "\\\"");
    }

    private static Candidate candidate(
            String name,
            int index,
            String feature) {

        Set<String> features =
                new LinkedHashSet<String>();

        features.add(feature);

        String code =
                "        invokeGeneratedCase(" + index + ");";

        return new Candidate(
                name,
                code,
                features);
    }

    private static List<Candidate> buildCandidates() {

        List<Candidate> result =
                new ArrayList<Candidate>();

        /*
         * Generic source-independent candidate pool.
         *
         * These cases deliberately do not copy original trigger
         * values. The actual arguments are constructed at runtime
         * from the target method parameter types.
         */

        result.add(candidate(
                "null_boundary",
                0,
                "NULL"));

        result.add(candidate(
                "empty_string",
                1,
                "EMPTY"));

        result.add(candidate(
                "short_string",
                2,
                "SHORT_STRING"));

        result.add(candidate(
                "normal_string",
                3,
                "NORMAL_STRING"));

        result.add(candidate(
                "long_string",
                4,
                "LONG_STRING"));

        result.add(candidate(
                "negative_integer",
                5,
                "NEGATIVE"));

        result.add(candidate(
                "zero_integer",
                6,
                "ZERO"));

        result.add(candidate(
                "positive_integer",
                7,
                "POSITIVE"));

        result.add(candidate(
                "integer_min",
                8,
                "MIN"));

        result.add(candidate(
                "integer_max",
                9,
                "MAX"));

        result.add(candidate(
                "negative_fraction",
                10,
                "NEGATIVE_FRACTION"));

        result.add(candidate(
                "zero_fraction",
                11,
                "ZERO_FRACTION"));

        result.add(candidate(
                "positive_fraction",
                12,
                "POSITIVE_FRACTION"));

        result.add(candidate(
                "large_fraction",
                13,
                "LARGE_FRACTION"));

        result.add(candidate(
                "true_boolean",
                14,
                "TRUE"));

        result.add(candidate(
                "false_boolean",
                15,
                "FALSE"));

        result.add(candidate(
                "zero_long",
                16,
                "LONG_ZERO"));

        result.add(candidate(
                "large_long",
                17,
                "LONG_LARGE"));

        result.add(candidate(
                "character_boundary",
                18,
                "CHAR"));

        result.add(candidate(
                "empty_array",
                19,
                "EMPTY_ARRAY"));

        result.add(candidate(
                "single_array",
                20,
                "SINGLE_ARRAY"));

        result.add(candidate(
                "enum_first",
                21,
                "ENUM"));

        result.add(candidate(
                "object_null",
                22,
                "OBJECT_NULL"));

        result.add(candidate(
                "object_boundary",
                23,
                "OBJECT_BOUNDARY"));

        return result;
    }

    private static class Provider
            implements CandidateProvider {

        private final String packageName;
        private final String className;

        Provider(
                String packageName,
                String className) {

            this.packageName = packageName;
            this.className = className;
        }

        @Override
        public List<Candidate> buildCandidates() {
            return buildCandidates();
        }

        @Override
        public double fitness(
                List<Candidate> candidates,
                boolean[] state) {

            Set<String> features =
                    new LinkedHashSet<String>();

            int selected = 0;

            for (int i = 0;
                 i < state.length;
                 i++) {

                if (!state[i]) {
                    continue;
                }

                selected++;

                features.addAll(
                        candidates
                                .get(i)
                                .getFeatures());
            }

            /*
             * Surrogate fitness:
             * maximize behavioral/type-boundary diversity.
             *
             * This is intentionally independent of the fixed
             * implementation and original trigger test.
             */
            return features.size()
                    + selected * 0.001;
        }

        @Override
        public String generateTestSuite(
                List<Candidate> candidates,
                boolean[] state,
                String packageName,
                String className) {

            StringBuilder out =
                    new StringBuilder();

            out.append("package ")
                    .append(packageName)
                    .append(";\n\n");

            out.append("import java.lang.reflect.Array;\n");
            out.append("import java.lang.reflect.Constructor;\n");
            out.append("import java.lang.reflect.Method;\n");
            out.append("import java.lang.reflect.Modifier;\n");
            out.append("import org.junit.Test;\n\n");

            out.append("public class ")
                    .append(className)
                    .append(" {\n\n");

            int testNo = 1;

            for (int i = 0;
                 i < state.length;
                 i++) {

                if (!state[i]) {
                    continue;
                }

                Candidate c = candidates.get(i);

                out.append("    @Test\n");
                out.append("    public void test")
                        .append(String.format("%02d", testNo))
                        .append("_")
                        .append(c.getName())
                        .append("() throws Exception {\n");

                out.append(c.getTestCode())
                        .append("\n");

                out.append("    }\n\n");

                testNo++;
            }

            out.append(
                "    private static void invokeGeneratedCase(int caseIndex) "
                + "throws Exception {\n");

            out.append(
                "        Class<?> target = Class.forName(\"")
                    .append(javaString(TARGET_CLASS_PLACEHOLDER))
                    .append("\");\n");

            out.append(
                "        Method targetMethod = null;\n");

            out.append(
                "        for (Method m : target.getDeclaredMethods()) {\n");

            out.append(
                "            if (m.getName().equals(\"")
                    .append(javaString(TARGET_METHOD_PLACEHOLDER))
                    .append("\")) {\n");

            out.append(
                "                targetMethod = m;\n"
                + "                break;\n"
                + "            }\n"
                + "        }\n");

            out.append(
                "        if (targetMethod == null) {\n"
                + "            throw new NoSuchMethodException(\"")
                    .append(javaString(TARGET_METHOD_PLACEHOLDER))
                    .append("\");\n"
                    + "        }\n");

            out.append(
                "        targetMethod.setAccessible(true);\n");

            out.append(
                "        Class<?>[] types = targetMethod.getParameterTypes();\n");

            out.append(
                "        Object[] args = buildArguments(types, caseIndex);\n");

            out.append(
                "        Object receiver = null;\n");

            out.append(
                "        if (!Modifier.isStatic(targetMethod.getModifiers())) {\n"
                + "            receiver = instantiate(target);\n"
                + "        }\n");

            out.append(
                "        targetMethod.invoke(receiver, args);\n");

            out.append(
                "    }\n\n");

            out.append(
                "    private static Object instantiate(Class<?> c) "
                + "throws Exception {\n");

            out.append(
                "        for (Constructor<?> ctor : c.getDeclaredConstructors()) {\n"
                + "            if (ctor.getParameterTypes().length == 0) {\n"
                + "                ctor.setAccessible(true);\n"
                + "                return ctor.newInstance();\n"
                + "            }\n"
                + "        }\n"
                + "        return null;\n"
                + "    }\n\n");

            out.append(
                "    private static Object[] buildArguments("
                + "Class<?>[] types, int caseIndex) {\n");

            out.append(
                "        Object[] args = new Object[types.length];\n");

            out.append(
                "        for (int i = 0; i < types.length; i++) {\n"
                + "            args[i] = buildValue(types[i], caseIndex, i);\n"
                + "        }\n"
                + "        return args;\n"
                + "    }\n\n");

            out.append(
                "    private static Object buildValue("
                + "Class<?> type, int caseIndex, int position) {\n");

            out.append(
                "        if (type == String.class) {\n"
                + "            switch (caseIndex) {\n"
                + "                case 0: return null;\n"
                + "                case 1: return \"\";\n"
                + "                case 2: return \"a\";\n"
                + "                case 3: return \"abc\";\n"
                + "                case 4: return \"abcdefghijklmnopqrstuvwxyz\";\n"
                + "                case 5: return \"-1\";\n"
                + "                case 6: return \"0\";\n"
                + "                case 7: return \"1\";\n"
                + "                case 8: return String.valueOf(Integer.MIN_VALUE);\n"
                + "                case 9: return String.valueOf(Integer.MAX_VALUE);\n"
                + "                case 10: return \"-1.25\";\n"
                + "                case 11: return \"0.0\";\n"
                + "                case 12: return \"1.25\";\n"
                + "                case 13: return \"999999999.999999\";\n"
                + "                case 14: return \"true\";\n"
                + "                case 15: return \"false\";\n"
                + "                default: return \"boundary\";\n"
                + "            }\n"
                + "        }\n");

            out.append(
                "        if (type == boolean.class || type == Boolean.class) {\n"
                + "            return (caseIndex % 2) == 0;\n"
                + "        }\n");

            out.append(
                "        if (type == int.class || type == Integer.class) {\n"
                + "            if (caseIndex == 8) return Integer.MIN_VALUE;\n"
                + "            if (caseIndex == 9) return Integer.MAX_VALUE;\n"
                + "            if (caseIndex == 5) return -1;\n"
                + "            if (caseIndex == 7) return 1;\n"
                + "            return 0;\n"
                + "        }\n");

            out.append(
                "        if (type == long.class || type == Long.class) {\n"
                + "            if (caseIndex == 17) return Long.MAX_VALUE;\n"
                + "            if (caseIndex == 5) return -1L;\n"
                + "            return 0L;\n"
                + "        }\n");

            out.append(
                "        if (type == double.class || type == Double.class) {\n"
                + "            if (caseIndex == 10) return -1.25d;\n"
                + "            if (caseIndex == 13) return 999999999.999999d;\n"
                + "            return 1.25d;\n"
                + "        }\n");

            out.append(
                "        if (type == float.class || type == Float.class) {\n"
                + "            return (float)1.25;\n"
                + "        }\n");

            out.append(
                "        if (type == short.class || type == Short.class) {\n"
                + "            return (short)0;\n"
                + "        }\n");

            out.append(
                "        if (type == byte.class || type == Byte.class) {\n"
                + "            return (byte)0;\n"
                + "        }\n");

            out.append(
                "        if (type == char.class || type == Character.class) {\n"
                + "            return caseIndex % 2 == 0 ? 'a' : 'Z';\n"
                + "        }\n");

            out.append(
                "        if (type.isArray()) {\n"
                + "            return Array.newInstance(type.getComponentType(), 0);\n"
                + "        }\n");

            out.append(
                "        if (type.isEnum()) {\n"
                + "            Object[] constants = type.getEnumConstants();\n"
                + "            return constants.length == 0 ? null : constants[0];\n"
                + "        }\n");

            out.append(
                "        return null;\n");

            out.append("    }\n");
            out.append("}\n");

            String result =
                    out.toString()
                        .replace(
                            TARGET_CLASS_PLACEHOLDER,
                            "$TARGET_CLASS_PLACEHOLDER$")
                        .replace(
                            TARGET_METHOD_PLACEHOLDER,
                            "$TARGET_METHOD_PLACEHOLDER$");

            return result;
        }
    }

    private static final String TARGET_CLASS_PLACEHOLDER =
            "__TARGET_CLASS__";

    private static final String TARGET_METHOD_PLACEHOLDER =
            "__TARGET_METHOD__";

    public static void main(String[] args)
            throws Exception {

        if (args.length != 7) {
            throw new IllegalArgumentException(
                "Expected: method package className targetClass "
                + "targetMethod output seed");
        }

        String method = args[0];
        String packageName = args[1];
        String className = args[2];
        String targetClass = args[3];
        String targetMethod = args[4];
        String output = args[5];
        long seed = Long.parseLong(args[6]);

        List<Candidate> candidates =
                buildCandidates();

        Provider provider =
                new Provider(packageName, className);

        boolean[] state;

        if ("SA".equals(method)) {

            SimulatedAnnealingEngine engine =
                    new SimulatedAnnealingEngine(
                        5000,
                        10.0,
                        0.995,
                        12,
                        seed);

            state =
                    engine.search(
                        candidates,
                        provider);

        } else {

            BinaryParticleSwarmEngine engine =
                    new BinaryParticleSwarmEngine(
                        20,
                        5000,
                        12,
                        seed);

            state =
                    engine.search(
                        candidates,
                        provider);
        }

        String suite =
                provider.generateTestSuite(
                    candidates,
                    state,
                    packageName,
                    className);

        suite = suite
                .replace("__TARGET_CLASS__",
                         targetClass)
                .replace("__TARGET_METHOD__",
                         targetMethod);

        File file = new File(output);

        File parent = file.getParentFile();

        if (parent != null) {
            parent.mkdirs();
        }

        FileWriter writer =
                new FileWriter(file);

        writer.write(suite);
        writer.close();

        int selected = 0;

        for (boolean b : state) {
            if (b) {
                selected++;
            }
        }

        System.out.println(
            "Generated tests : " + selected);

        System.out.println(
            "Candidate pool  : " + candidates.size());

        System.out.println(
            "Method           : " + method);

        System.out.println(
            "Seed             : " + seed);

        System.out.println(
            "Output           : " + output);
    }
}
JAVA

###############################################################################
# Compile driver.
###############################################################################

javac \
    -cp "$ENGINE_CLASSES" \
    -d "$ENGINE_CLASSES" \
    "$DRIVER"

if [[ $? -ne 0 ]]; then
    echo "ERROR: generic algorithm driver compilation failed."
    printf '%s\n' "PENDING_GENERATOR" > "$ARTIFACT_DIR/status"
    exit 3
fi


###############################################################################
# Run generator.
###############################################################################

OUTPUT="$ARTIFACT_DIR/generated_test.java"

java \
    -cp "$ENGINE_CLASSES" \
    GenericAlgorithmDriver \
    "$METHOD" \
    "$PACKAGE_NAME" \
    "$TEST_CLASS" \
    "$TARGET_CLASS" \
    "$TARGET_METHOD" \
    "$OUTPUT" \
    20260923

GEN_RC=$?

if [[ $GEN_RC -ne 0 || ! -s "$OUTPUT" ]]; then
    echo "ERROR: generation failed."
    printf '%s\n' "PENDING_GENERATOR" > "$ARTIFACT_DIR/status"
    exit 3
fi


###############################################################################
# Record generation metadata.
###############################################################################

cat > "$ARTIFACT_DIR/generation.log" <<EOF
Project=$PROJECT
Bug=$BUG
Method=$METHOD
TargetClass=$TARGET_CLASS
TargetMethod=$TARGET_METHOD
Package=$PACKAGE_NAME
GeneratedClass=$TEST_CLASS
CandidatePool=24
SuiteSize=12
Iterations=5000
Seed=20260923
GeneratorMode=GENERIC_REFLECTION_CANDIDATE_POOL
IndependentTriggerInputs=true
Output=$OUTPUT
EOF

printf '%s\n' "GENERATED" > "$ARTIFACT_DIR/status"

echo ""
echo "STATUS      : GENERATED"
echo "Generated   : $OUTPUT"
echo "============================================================"

exit 0
