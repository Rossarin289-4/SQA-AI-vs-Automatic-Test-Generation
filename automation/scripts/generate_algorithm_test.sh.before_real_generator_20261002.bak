#!/bin/zsh

set -u

ROOT="$(cd "$(dirname "$0")/../.." && pwd)"

PROJECT="${1:-}"
BUG="${2:-}"
METHOD="${3:-}"
ARTIFACT_DIR="${4:-}"

if [[ -z "$PROJECT" || -z "$BUG" || -z "$METHOD" ]]; then
    echo "Usage:"
    echo "  $0 <project> <bug> <method> <artifact_dir>"
    echo
    echo "Supported methods:"
    echo "  SA"
    echo "  BPSO"
    exit 2
fi

if [[ -z "$ARTIFACT_DIR" ]]; then
    echo "ERROR: artifact_dir is required"
    exit 2
fi

case "$METHOD" in
    SA|BPSO)
        ;;
    *)
        echo "ERROR: Unsupported algorithm method: $METHOD"
        exit 2
        ;;
esac

mkdir -p "$ARTIFACT_DIR"

echo "============================================================"
echo "ALGORITHM TEST GENERATION"
echo "============================================================"
echo "Project     : $PROJECT"
echo "Bug         : $BUG"
echo "Method      : $METHOD"
echo "Artifact    : $ARTIFACT_DIR"
echo
echo "STATUS      : NOT_IMPLEMENTED"
echo
echo "The generalized $METHOD generator has not yet been connected."
echo "Historical Lang-3/Lang-4 generators remain preserved separately."
echo "No historical generator is executed implicitly by this interface."
echo "============================================================"

printf '%s\n' \
    "Project=$PROJECT" \
    "Bug=$BUG" \
    "Method=$METHOD" \
    "Status=NOT_IMPLEMENTED" \
    > "$ARTIFACT_DIR/generation.log"

printf '%s\n' \
    "PENDING_GENERATOR" \
    > "$ARTIFACT_DIR/status"

exit 3
