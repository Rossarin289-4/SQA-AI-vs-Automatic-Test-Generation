#!/bin/zsh

set -u

ROOT="$(cd "$(dirname "$0")/../.." && pwd)"

PROJECT="${1:-}"
BUG="${2:-}"
METHOD="${3:-}"
ARTIFACT_DIR="${4:-}"

if [[ -z "$PROJECT" || -z "$BUG" || -z "$METHOD" || -z "$ARTIFACT_DIR" ]]; then
    echo "Usage:"
    echo "  generate_algorithm_test.sh <project> <bug> <method> <artifact_dir>"
    exit 2
fi

if [[ "$PROJECT" != "Lang" ]]; then
    echo "ERROR: current generator implementation supports Lang."
    printf '%s\n' "PENDING_GENERATOR" > "$ARTIFACT_DIR/status"
    exit 3
fi

if [[ "$METHOD" != "SA" && "$METHOD" != "BPSO" ]]; then
    echo "ERROR: unsupported method: $METHOD"
    printf '%s\n' "PENDING_GENERATOR" > "$ARTIFACT_DIR/status"
    exit 3
fi

mkdir -p "$ARTIFACT_DIR"

D4J="/Users/fangfang/Documents/SQA_Project/defects4j/framework/bin/defects4j"
METADATA="$ROOT/automation/datasets/Lang/bugs.csv"

if [[ ! -x "$D4J" ]]; then
    echo "ERROR: Defects4J executable not found:"
    echo "$D4J"
    printf '%s\n' "PENDING_GENERATOR" > "$ARTIFACT_DIR/status"
    exit 3
fi

if [[ ! -f "$METADATA" ]]; then
    echo "ERROR: metadata not found:"
    echo "$METADATA"
    printf '%s\n' "PENDING_GENERATOR" > "$ARTIFACT_DIR/status"
    exit 3
fi

echo "============================================================"
echo "CORRECTED SA/BPSO GENERATOR"
echo "============================================================"
echo "Project : $PROJECT"
echo "Bug     : $BUG"
echo "Method  : $METHOD"
echo "Artifact: $ARTIFACT_DIR"
echo "============================================================"


###############################################################################
# 4. Read Defects4J metadata.
###############################################################################

META_JSON="$(
python3 - "$METADATA" "$BUG" <<'PY'
import csv
import json
import sys

path = sys.argv[1]
bug = str(sys.argv[2])

with open(path, newline="", encoding="utf-8") as f:
    rows = list(csv.DictReader(f))

matches = [r for r in rows if str(r["bug_id"]) == bug]

if not matches:
    print(json.dumps({"error": "bug_not_found"}))
    raise SystemExit(0)

row = matches[0]

print(json.dumps({
    "bug_id": row["bug_id"],
    "fixed_revision": row["fixed_revision"],
    "trigger_test": row["trigger_test"],
    "modified_source": row["modified_source"]
}))
PY
)"

if [[ "$META_JSON" == *'"error"'* ]]; then
    echo "ERROR: bug not found in metadata."
    printf '%s\n' "PENDING_GENERATOR" > "$ARTIFACT_DIR/status"
    exit 3
fi

FIXED_REVISION="$(
python3 - "$META_JSON" <<'PY'
import json, sys
print(json.loads(sys.argv[1])["fixed_revision"])
PY
)"

MODIFIED_SOURCE="$(
python3 - "$META_JSON" <<'PY'
import json, sys
print(json.loads(sys.argv[1])["modified_source"])
PY
)"

TRIGGER_TEST="$(
python3 - "$META_JSON" <<'PY'
import json, sys
print(json.loads(sys.argv[1])["trigger_test"])
PY
)"

echo "Modified source : $MODIFIED_SOURCE"
echo "Trigger test    : $TRIGGER_TEST"
echo "Fixed revision  : $FIXED_REVISION"


###############################################################################
# 5. Resolve class name.
###############################################################################

TARGET_CLASS="$(
python3 - "$MODIFIED_SOURCE" <<'PY'
import sys

value = sys.argv[1].strip()

value = value.replace("/", ".")

if value.endswith(".java"):
    value = value[:-5]

print(value)
PY
)"

PACKAGE_NAME="${TARGET_CLASS%.*}"

echo "Target class    : $TARGET_CLASS"
echo "Package         : $PACKAGE_NAME"


###############################################################################
# 6. Create temporary BUGGY/FIXED source copies.
#
# No rm -rf is used.
# A unique temporary directory is used and simply left for inspection.
###############################################################################

TMP_ROOT="$(
    mktemp -d "/tmp/sqa_lang_generator_${BUG}_${METHOD}_XXXXXX"
)"

BUGGY_DIR="$TMP_ROOT/buggy"
FIXED_DIR="$TMP_ROOT/fixed"

echo ""
echo "Temporary generator workspace:"
echo "$TMP_ROOT"

mkdir -p "$BUGGY_DIR"
mkdir -p "$FIXED_DIR"


###############################################################################
# 7. Checkout BUGGY and FIXED versions.
###############################################################################

echo ""
echo "============================================================"
echo "CHECKOUT BUGGY"
echo "============================================================"

"$D4J" checkout \
    -p Lang \
    -v "${BUG}b" \
    -w "$BUGGY_DIR"

BUGGY_CHECKOUT_RC=$?

if [[ $BUGGY_CHECKOUT_RC -ne 0 ]]; then
    echo "ERROR: BUGGY checkout failed."
    printf '%s\n' "PENDING_GENERATOR" > "$ARTIFACT_DIR/status"
    exit 3
fi


echo ""
echo "============================================================"
echo "CHECKOUT FIXED"
echo "============================================================"

"$D4J" checkout \
    -p Lang \
    -v "${BUG}f" \
    -w "$FIXED_DIR"

FIXED_CHECKOUT_RC=$?

if [[ $FIXED_CHECKOUT_RC -ne 0 ]]; then
    echo "ERROR: FIXED checkout failed."
    printf '%s\n' "PENDING_GENERATOR" > "$ARTIFACT_DIR/status"
    exit 3
fi


###############################################################################
# 8. Locate modified production source.
###############################################################################

SOURCE_RELATIVE_PATH="$(
python3 - "$MODIFIED_SOURCE" <<'PY2'
import sys

name = sys.argv[1].strip()

if name.endswith(".java"):
    name = name[:-5]

print(name.replace(".", "/") + ".java")
PY2
)"

BUGGY_SOURCE="$BUGGY_DIR/src/main/java/$SOURCE_RELATIVE_PATH"
FIXED_SOURCE="$FIXED_DIR/src/main/java/$SOURCE_RELATIVE_PATH"

if [[ ! -f "$BUGGY_SOURCE" ]]; then
    BUGGY_SOURCE="$(
        find "$BUGGY_DIR/src/main/java"             -type f             -name "$(basename "$SOURCE_RELATIVE_PATH")"             -print             | head -1
    )"
fi

if [[ ! -f "$FIXED_SOURCE" ]]; then
    FIXED_SOURCE="$(
        find "$FIXED_DIR/src/main/java"             -type f             -name "$(basename "$SOURCE_RELATIVE_PATH")"             -print             | head -1
    )"
fi

echo ""
echo "BUGGY source:"
echo "$BUGGY_SOURCE"

echo "FIXED source:"
echo "$FIXED_SOURCE"

if [[ ! -f "$BUGGY_SOURCE" || ! -f "$FIXED_SOURCE" ]]; then
    echo "ERROR: modified production source not found."
    printf '%s\n' "PENDING_GENERATOR" > "$ARTIFACT_DIR/status"
    exit 3
fi


###############################################################################
# 9. Determine actual production method from BUGGY/FIXED diff.
#
# We deliberately do NOT use trigger_test method.
###############################################################################

METHOD_JSON="$(
python3 - "$BUGGY_SOURCE" "$FIXED_SOURCE" <<'PY'
import re
import sys
import difflib

buggy_path = sys.argv[1]
fixed_path = sys.argv[2]

with open(buggy_path, encoding="utf-8", errors="ignore") as f:
    buggy = f.readlines()

with open(fixed_path, encoding="utf-8", errors="ignore") as f:
    fixed = f.readlines()

diff = list(
    difflib.unified_diff(
        buggy,
        fixed,
        n=8
    )
)

method_pattern = re.compile(
    r'^\s*'
    r'(?:public|protected|private)?\s*'
    r'(?:static\s+)?'
    r'(?:final\s+)?'
    r'(?:synchronized\s+)?'
    r'(?:<[^>]+>\s*)?'
    r'[A-Za-z_$][\w$<>\[\], ?]*\s+'
    r'([A-Za-z_$][\w$]*)\s*'
    r'\('
)

names = []

for line in diff:
    if not (line.startswith("+") or line.startswith("-")):
        continue

    if line.startswith("+++") or line.startswith("---"):
        continue

    text = line[1:]

    m = method_pattern.search(text)

    if m:
        name = m.group(1)

        if name not in names:
            names.append(name)

# Fallback: scan changed-file context if method declaration
# itself is not included in the diff.
if not names:
    changed_regions = []

    for line in diff:
        if line.startswith("@@"):
            changed_regions.append(line)

    combined = "".join(buggy + fixed)

    for m in method_pattern.finditer(combined):
        name = m.group(1)

        if name not in names:
            names.append(name)

# Exclude obvious language constructs.
bad = {
    "if", "for", "while", "switch",
    "catch", "try", "finally",
    "new", "return"
}

names = [n for n in names if n not in bad]

print({
    "methods": names
})
PY
)"

TARGET_METHOD="$(
python3 - "$METHOD_JSON" <<'PY'
import ast
import sys

text = sys.argv[1]

data = ast.literal_eval(text)

methods = data.get("methods", [])

if methods:
    print(methods[0])
else:
    print("")
PY
)"

echo ""
echo "============================================================"
echo "ACTUAL PRODUCTION METHOD"
echo "============================================================"
echo "Trigger method : $(
python3 - "$TRIGGER_TEST" <<'PY'
import sys

value = sys.argv[1]

if "::" in value:
    print(value.split("::")[-1])
else:
    print(value)
PY
)"
echo "Production method: $TARGET_METHOD"
echo "============================================================"

if [[ -z "$TARGET_METHOD" ]]; then
    echo "ERROR: could not determine modified production method."
    echo ""
    echo "The generator will NOT create a potentially invalid suite."
    printf '%s\n' "PENDING_GENERATOR" > "$ARTIFACT_DIR/status"
    exit 3
fi


###############################################################################
# 10. Compile generic engines using the ACTUAL API.
###############################################################################

TMP_CLASSES="$TMP_ROOT/classes"

mkdir -p "$TMP_CLASSES"

COMMON="$ROOT/automation/scripts/generators/common"
SA="$ROOT/automation/scripts/generators/sa"
BPSO="$ROOT/automation/scripts/generators/bpso"

echo ""
echo "============================================================"
echo "COMPILE GENERIC ENGINES"
echo "============================================================"

javac \
    -d "$TMP_CLASSES" \
    "$COMMON/Candidate.java" \
    "$COMMON/CandidateProvider.java" \
    "$SA/SimulatedAnnealingEngine.java" \
    "$BPSO/BinaryParticleSwarmEngine.java"

ENGINE_RC=$?

if [[ $ENGINE_RC -ne 0 ]]; then
    echo "ERROR: engine compilation failed."
    printf '%s\n' "PENDING_GENERATOR" > "$ARTIFACT_DIR/status"
    exit 3
fi

echo "[PASS] Generic engines compiled."


###############################################################################
# 11. Inspect constructors instead of guessing them.
###############################################################################

echo ""
echo "============================================================"
echo "VERIFY ENGINE API"
echo "============================================================"

javap -classpath "$TMP_CLASSES" \
    generators.sa.SimulatedAnnealingEngine

javap -classpath "$TMP_CLASSES" \
    generators.bpso.BinaryParticleSwarmEngine


###############################################################################
# 12. Build candidate-provider driver.
#
# Candidate values are generated from parameter types.
# Expected values are deliberately not copied from Defects4J
# trigger tests.
###############################################################################

DRIVER="$TMP_ROOT/GenericAlgorithmDriver.java"

cat > "$DRIVER" <<'JAVA'
import generators.common.Candidate;
import generators.common.CandidateProvider;
import generators.sa.SimulatedAnnealingEngine;
import generators.bpso.BinaryParticleSwarmEngine;

import java.io.File;
import java.io.FileWriter;
import java.util.ArrayList;
import java.util.LinkedHashSet;
import java.util.List;
import java.util.Set;

public class GenericAlgorithmDriver {

    private static final long SEED = 20260923L;

    private static final String TARGET_CLASS =
        "__TARGET_CLASS__";

    private static final String TARGET_METHOD =
        "__TARGET_METHOD__";

    private static final String PACKAGE_NAME =
        "__PACKAGE_NAME__";

    private static final String GENERATED_CLASS =
        "__GENERATED_CLASS__";

    static class C implements Candidate {

        private final String name;
        private final String code;
        private final Set<String> features;

        C(String name, String code, String... features) {
            this.name = name;
            this.code = code;

            this.features =
                new LinkedHashSet<String>();

            for (String f : features) {
                this.features.add(f);
            }
        }

        public String getName() {
            return name;
        }

        public String getCode() {
            return code;
        }

        public Set<String> getFeatures() {
            return features;
        }
    }

    static List<C> candidates() {

        List<C> list =
            new ArrayList<C>();

        list.add(new C(
            "null_boundary",
            "caseInvoke(0)",
            "NULL"));

        list.add(new C(
            "empty_boundary",
            "caseInvoke(1)",
            "EMPTY"));

        list.add(new C(
            "zero_boundary",
            "caseInvoke(2)",
            "ZERO"));

        list.add(new C(
            "negative_boundary",
            "caseInvoke(3)",
            "NEGATIVE"));

        list.add(new C(
            "positive_boundary",
            "caseInvoke(4)",
            "POSITIVE"));

        list.add(new C(
            "min_boundary",
            "caseInvoke(5)",
            "MIN"));

        list.add(new C(
            "max_boundary",
            "caseInvoke(6)",
            "MAX"));

        list.add(new C(
            "short_string",
            "caseInvoke(7)",
            "SHORT"));

        list.add(new C(
            "long_string",
            "caseInvoke(8)",
            "LONG"));

        list.add(new C(
            "fraction_negative",
            "caseInvoke(9)",
            "NEGATIVE_FRACTION"));

        list.add(new C(
            "fraction_zero",
            "caseInvoke(10)",
            "ZERO_FRACTION"));

        list.add(new C(
            "fraction_positive",
            "caseInvoke(11)",
            "POSITIVE_FRACTION"));

        list.add(new C(
            "large_fraction",
            "caseInvoke(12)",
            "LARGE_FRACTION"));

        list.add(new C(
            "boolean_true",
            "caseInvoke(13)",
            "TRUE"));

        list.add(new C(
            "boolean_false",
            "caseInvoke(14)",
            "FALSE"));

        list.add(new C(
            "long_zero",
            "caseInvoke(15)",
            "LONG_ZERO"));

        list.add(new C(
            "long_large",
            "caseInvoke(16)",
            "LONG_LARGE"));

        list.add(new C(
            "char_boundary",
            "caseInvoke(17)",
            "CHAR"));

        list.add(new C(
            "empty_array",
            "caseInvoke(18)",
            "ARRAY"));

        list.add(new C(
            "object_null",
            "caseInvoke(19)",
            "OBJECT"));

        list.add(new C(
            "object_boundary",
            "caseInvoke(20)",
            "OBJECT_BOUNDARY"));

        list.add(new C(
            "repeat_boundary",
            "caseInvoke(21)",
            "REPEAT"));

        list.add(new C(
            "mixed_boundary",
            "caseInvoke(22)",
            "MIXED"));

        list.add(new C(
            "final_boundary",
            "caseInvoke(23)",
            "FINAL"));

        return list;
    }

    static class Provider implements CandidateProvider {

        private final List<C> pool;

        Provider(List<C> pool) {
            this.pool = pool;
        }

        @Override
        public List<C> buildCandidates() {
            return pool;
        }

        @Override
        public double fitness(
                List<C> candidates,
                boolean[] state) {

            Set<String> features =
                new LinkedHashSet<String>();

            int selected = 0;

            for (int i = 0;
                 i < state.length;
                 i++) {

                if (state[i]) {
                    selected++;
                    features.addAll(
                        candidates
                            .get(i)
                            .getFeatures());
                }
            }

            /*
             * Search objective:
             * maximize behavioral boundary diversity
             * while preferring the configured suite size.
             */
            double diversity =
                features.size();

            double sizePenalty =
                Math.abs(selected - 12) * 0.05;

            return diversity - sizePenalty;
        }

        @Override
        public String generateTestSuite(
                List<C> candidates,
                boolean[] state,
                String packageName,
                String className) {

            StringBuilder out =
                new StringBuilder();

            out.append(
                "package "
                + packageName
                + ";\n\n");

            out.append(
                "import java.lang.reflect.Array;\n");

            out.append(
                "import java.lang.reflect.Constructor;\n");

            out.append(
                "import java.lang.reflect.Method;\n");

            out.append(
                "import java.lang.reflect.Modifier;\n");

            out.append(
                "import org.junit.Test;\n\n");

            out.append(
                "public class "
                + className
                + " {\n\n");

            int number = 1;

            for (int i = 0;
                 i < state.length;
                 i++) {

                if (!state[i]) {
                    continue;
                }

                C c = candidates.get(i);

                out.append(
                    "    @Test\n");

                out.append(
                    "    public void test"
                    + String.format("%02d", number)
                    + "_"
                    + c.getName()
                    + "() throws Exception {\n");

                out.append(
                    "        "
                    + c.getCode()
                    + ";\n");

                out.append(
                    "    }\n\n");

                number++;
            }

            out.append(
                "    private static void caseInvoke("
                + "int index) throws Exception {\n");

            out.append(
                "        Class<?> c = Class.forName(\""
                + TARGET_CLASS
                + "\");\n");

            out.append(
                "        Method selected = null;\n");

            out.append(
                "        for (Method m : c.getDeclaredMethods()) {\n");

            out.append(
                "            if (m.getName().equals(\""
                + TARGET_METHOD
                + "\")) {\n");

            out.append(
                "                selected = m;\n"
                + "                break;\n"
                + "            }\n"
                + "        }\n");

            out.append(
                "        if (selected == null) {\n");

            out.append(
                "            throw new NoSuchMethodException(\""
                + TARGET_METHOD
                + "\");\n");

            out.append(
                "        }\n");

            out.append(
                "        selected.setAccessible(true);\n");

            out.append(
                "        Object[] args = values("
                + "selected.getParameterTypes(), index);\n");

            out.append(
                "        Object receiver = null;\n");

            out.append(
                "        if (!Modifier.isStatic(selected.getModifiers())) {\n");

            out.append(
                "            Constructor<?>[] ctors = "
                + "c.getDeclaredConstructors();\n");

            out.append(
                "            for (Constructor<?> ctor : ctors) {\n");

            out.append(
                "                if (ctor.getParameterTypes().length == 0) {\n");

            out.append(
                "                    ctor.setAccessible(true);\n");

            out.append(
                "                    receiver = ctor.newInstance();\n");

            out.append(
                "                    break;\n");

            out.append(
                "                }\n");

            out.append(
                "            }\n");

            out.append(
                "        }\n");

            out.append(
                "        selected.invoke(receiver, args);\n");

            out.append(
                "    }\n\n");

            out.append(
                "    private static Object[] values("
                + "Class<?>[] types, int index) {\n");

            out.append(
                "        Object[] result = "
                + "new Object[types.length];\n");

            out.append(
                "        for (int i = 0; i < types.length; i++) {\n");

            out.append(
                "            result[i] = value("
                + "types[i], index, i);\n");

            out.append(
                "        }\n");

            out.append(
                "        return result;\n");

            out.append(
                "    }\n\n");

            out.append(
                "    private static Object value("
                + "Class<?> t, int index, int position) {\n");

            out.append(
                "        if (t == String.class) {\n"
                + "            switch (index) {\n"
                + "                case 0: return null;\n"
                + "                case 1: return \"\";\n"
                + "                case 2: return \"0\";\n"
                + "                case 3: return \"-1\";\n"
                + "                case 4: return \"1\";\n"
                + "                case 5: return String.valueOf(Integer.MIN_VALUE);\n"
                + "                case 6: return String.valueOf(Integer.MAX_VALUE);\n"
                + "                case 7: return \"a\";\n"
                + "                case 8: return \"abcdefghijklmnopqrstuvwxyz\";\n"
                + "                case 9: return \"-1.25\";\n"
                + "                case 10: return \"0.0\";\n"
                + "                case 11: return \"1.25\";\n"
                + "                case 12: return \"999999999.999999\";\n"
                + "                case 13: return \"true\";\n"
                + "                case 14: return \"false\";\n"
                + "                default: return \"boundary\";\n"
                + "            }\n"
                + "        }\n");

            out.append(
                "        if (t == boolean.class || t == Boolean.class) {\n"
                + "            return (index % 2) == 0;\n"
                + "        }\n");

            out.append(
                "        if (t == int.class || t == Integer.class) {\n"
                + "            if (index == 3) return -1;\n"
                + "            if (index == 5) return Integer.MIN_VALUE;\n"
                + "            if (index == 6) return Integer.MAX_VALUE;\n"
                + "            return index == 4 ? 1 : 0;\n"
                + "        }\n");

            out.append(
                "        if (t == long.class || t == Long.class) {\n"
                + "            if (index == 16) return Long.MAX_VALUE;\n"
                + "            if (index == 3) return -1L;\n"
                + "            return index == 4 ? 1L : 0L;\n"
                + "        }\n");

            out.append(
                "        if (t == double.class || t == Double.class) {\n"
                + "            if (index == 9) return -1.25d;\n"
                + "            if (index == 12) return 999999999.999999d;\n"
                + "            return index == 11 ? 1.25d : 0.0d;\n"
                + "        }\n");

            out.append(
                "        if (t == float.class || t == Float.class) {\n"
                + "            return 1.25f;\n"
                + "        }\n");

            out.append(
                "        if (t == short.class || t == Short.class) {\n"
                + "            return (short)0;\n"
                + "        }\n");

            out.append(
                "        if (t == byte.class || t == Byte.class) {\n"
                + "            return (byte)0;\n"
                + "        }\n");

            out.append(
                "        if (t == char.class || t == Character.class) {\n"
                + "            return index % 2 == 0 ? 'a' : 'Z';\n"
                + "        }\n");

            out.append(
                "        if (t.isArray()) {\n"
                + "            return Array.newInstance(t.getComponentType(), 0);\n"
                + "        }\n");

            out.append(
                "        if (t.isEnum()) {\n"
                + "            Object[] values = t.getEnumConstants();\n"
                + "            return values.length == 0 ? null : values[0];\n"
                + "        }\n");

            out.append(
                "        return null;\n");

            out.append(
                "    }\n");

            out.append("}\n");

            return out.toString();
        }
    }

    public static void main(String[] args)
        throws Exception {

        String algorithm = args[0];
        String output = args[1];

        List<C> pool = candidates();

        Provider provider =
            new Provider(pool);

        boolean[] state;

        if ("SA".equals(algorithm)) {

            /*
             * Actual API:
             * SimulatedAnnealingEngine(int iterations,
             *                           int suiteSize,
             *                           long seed)
             */
            SimulatedAnnealingEngine engine =
                new SimulatedAnnealingEngine(
                    5000,
                    12,
                    SEED);

            state =
                engine.search(
                    pool,
                    provider);

        } else {

            /*
             * Actual API:
             * BinaryParticleSwarmEngine(int particles,
             *                            int iterations,
             *                            int suiteSize,
             *                            long seed)
             */
            BinaryParticleSwarmEngine engine =
                new BinaryParticleSwarmEngine(
                    20,
                    5000,
                    12,
                    SEED);

            state =
                engine.search(
                    pool,
                    provider);
        }

        String suite =
            provider.generateTestSuite(
                pool,
                state,
                PACKAGE_NAME,
                GENERATED_CLASS);

        File file =
            new File(output);

        File parent =
            file.getParentFile();

        if (parent != null) {
            parent.mkdirs();
        }

        FileWriter writer =
            new FileWriter(file);

        writer.write(suite);
        writer.close();

        int selected = 0;

        for (boolean b : state) {
            if (b) {
                selected++;
            }
        }

        System.out.println(
            "Candidate pool : "
            + pool.size());

        System.out.println(
            "Selected tests  : "
            + selected);

        System.out.println(
            "Algorithm       : "
            + algorithm);

        System.out.println(
            "Output          : "
            + output);
    }
}
JAVA


###############################################################################
# 13. Replace placeholders safely.
###############################################################################

GENERATED_CLASS="Lang${BUG}GeneratedTest${METHOD}"

python3 - \
    "$DRIVER" \
    "$TARGET_CLASS" \
    "$TARGET_METHOD" \
    "$PACKAGE_NAME" \
    "$GENERATED_CLASS" \
    "$DRIVER" \
    <<'PY'
import sys
from pathlib import Path

source_path = Path(sys.argv[1])

target_class = sys.argv[2]
target_method = sys.argv[3]
package_name = sys.argv[4]
generated_class = sys.argv[5]

text = source_path.read_text()

text = text.replace(
    "__TARGET_CLASS__",
    target_class
)

text = text.replace(
    "__TARGET_METHOD__",
    target_method
)

text = text.replace(
    "__PACKAGE_NAME__",
    package_name
)

text = text.replace(
    "__GENERATED_CLASS__",
    generated_class
)

source_path.write_text(text)
PY


###############################################################################
# 14. Compile driver.
###############################################################################

echo ""
echo "============================================================"
echo "COMPILE DRIVER"
echo "============================================================"

javac \
    -cp "$TMP_CLASSES" \
    -d "$TMP_CLASSES" \
    "$DRIVER"

DRIVER_RC=$?

if [[ $DRIVER_RC -ne 0 ]]; then
    echo "ERROR: driver compilation failed."
    printf '%s\n' "PENDING_GENERATOR" > "$ARTIFACT_DIR/status"
    exit 3
fi

echo "[PASS] Driver compiled."


###############################################################################
# 15. Generate test suite.
###############################################################################

OUTPUT="$ARTIFACT_DIR/generated_test.java"

echo ""
echo "============================================================"
echo "RUN $METHOD"
echo "============================================================"

java \
    -cp "$TMP_CLASSES" \
    GenericAlgorithmDriver \
    "$METHOD" \
    "$OUTPUT"

GEN_RC=$?

if [[ $GEN_RC -ne 0 || ! -s "$OUTPUT" ]]; then
    echo "ERROR: generated test suite was not produced."
    printf '%s\n' "PENDING_GENERATOR" > "$ARTIFACT_DIR/status"
    exit 3
fi


###############################################################################
# 16. Save traceability metadata.
###############################################################################

cat > "$ARTIFACT_DIR/generation.log" <<EOF
Project=Lang
Bug=$BUG
Algorithm=$METHOD
TargetClass=$TARGET_CLASS
TargetMethod=$TARGET_METHOD
TriggerTest=$TRIGGER_TEST
ModifiedSource=$MODIFIED_SOURCE
FixedRevision=$FIXED_REVISION
CandidatePool=24
SuiteSize=12
Iterations=5000
Seed=20260923
Generator=GenericCandidateProvider
TriggerInputsCopied=false
TemporaryGeneratorWorkspace=$TMP_ROOT
GeneratedClass=$GENERATED_CLASS
EOF

printf '%s\n' "GENERATED" > "$ARTIFACT_DIR/status"

echo ""
echo "============================================================"
echo "GENERATION SUCCESS"
echo "============================================================"
echo "Status : GENERATED"
echo "File   : $OUTPUT"
echo "Class  : $GENERATED_CLASS"
echo "Method : $TARGET_METHOD"
echo "============================================================"

exit 0
